<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" style="-fx-padding: 30; -fx-background-color: transparent;" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ReturnBookPageController">
    <Label text="Return Book" textFill="#333333">
        <font><Font name="System Bold" size="26.0" /></font>
    </Label>

    <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 5);" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <TextField fx:id="txtSearchRecord" prefHeight="36.0" prefWidth="260.0" promptText="Search by Member ID, Book ID, or Record..." style="-fx-background-radius: 6; -fx-border-color: #e0e0e0; -fx-border-radius: 6;" />
            <Button mnemonicParsing="false" onAction="#btnSearchReturnOnAction" prefHeight="36.0" prefWidth="100.0" style="-fx-background-color: #1abfc7; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" text="Search">
                <font><Font name="System Bold" size="13.0" /></font>
            </Button>
            <Button mnemonicParsing="false" onAction="#btnRefreshReturnOnAction" prefHeight="36.0" prefWidth="100.0" style="-fx-background-color: transparent; -fx-border-color: #94a3b8; -fx-border-radius: 6; -fx-text-fill: #475569; -fx-cursor: hand;" text="Refresh">
                <font><Font name="System Bold" size="13.0" /></font>
            </Button>
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#btnReturnBookOnAction" prefHeight="36.0" prefWidth="140.0" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" text="Return Book">
                <font><Font name="System Bold" size="13.0" /></font>
            </Button>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="25.0">
            <Label fx:id="lblSelectedInfo" text="No borrow record selected" textFill="#475569">
                <font><Font name="System Bold" size="13.0" /></font>
            </Label>
            <Label fx:id="lblFineAmount" text="Fine: LKR 0.00" textFill="#dc2626">
                <font><Font name="System Bold" size="13.0" /></font>
            </Label>
        </HBox>

        <TableView fx:id="tblActiveBorrows" style="-fx-border-color: #e0e0e0; -fx-border-radius: 6; -fx-background-radius: 6;" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colRecordId" prefWidth="110.0" text="Record ID" />
                <TableColumn fx:id="colMemberId" prefWidth="130.0" text="Member ID" />
                <TableColumn fx:id="colBookId" prefWidth="140.0" text="Book ID" />
                <TableColumn fx:id="colIssueDate" prefWidth="130.0" text="Issue Date" />
                <TableColumn fx:id="colDueDate" prefWidth="130.0" text="Due Date" />
                <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
            </columns>
        </TableView>
    </VBox>
</VBox>