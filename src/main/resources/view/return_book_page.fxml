<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" style="-fx-padding: 30;" stylesheets="@../css/style.css" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ReturnBookPageController">
    <Label styleClass="page-title" text="Return Book" />

    <VBox spacing="15.0" styleClass="card-panel" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <TextField fx:id="txtSearchRecord" prefHeight="38.0" prefWidth="260.0" promptText="Search by Member ID, Book ID, or Record..." styleClass="input-field" />
            <Button mnemonicParsing="false" onAction="#btnSearchReturnOnAction" prefHeight="38.0" prefWidth="100.0" styleClass="btn-primary" text="Search" />
            <Button mnemonicParsing="false" onAction="#btnRefreshReturnOnAction" prefHeight="38.0" prefWidth="100.0" styleClass="btn-neutral" text="Refresh" />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#btnReturnBookOnAction" prefHeight="38.0" prefWidth="140.0" styleClass="btn-success" text="Return Book" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="25.0">
            <Label fx:id="lblSelectedInfo" styleClass="field-label" text="No borrow record selected" />
            <Label fx:id="lblFineAmount" styleClass="fine-label" text="Fine: LKR 0.00" />
        </HBox>

        <TableView fx:id="tblActiveBorrows" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colRecordId" prefWidth="90.0" text="ID" />
                <TableColumn fx:id="colMemberId" prefWidth="130.0" text="Member ID" />
                <TableColumn fx:id="colBookId" prefWidth="140.0" text="Book ID" />
                <TableColumn fx:id="colIssueDate" prefWidth="130.0" text="Issue Date" />
                <TableColumn fx:id="colDueDate" prefWidth="130.0" text="Due Date" />
                <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
            </columns>
        </TableView>
    </VBox>
</VBox>