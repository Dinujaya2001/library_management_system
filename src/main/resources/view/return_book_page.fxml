<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" style="-fx-padding: 30; -fx-background-color: transparent;" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ReturnBookPageController">
    <Label text="Return Book" textFill="#333333">
        <font><Font name="System Bold" size="26.0" /></font>
    </Label>

    <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 5);" maxWidth="600">

        <HBox spacing="10">
            <TextField fx:id="txtSearchBook" promptText="Enter Book ID or Member ID" prefHeight="40.0" HBox.hgrow="ALWAYS" style="-fx-background-radius: 6; -fx-border-color: #e0e0e0; -fx-border-radius: 6;" />
            <Button text="Search" prefHeight="40.0" style="-fx-background-color: #334155; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" />
        </HBox>

        <Separator />

        <!-- Info Display -->
        <GridPane vgap="10" hgap="20">
            <Label text="Member Info:" textFill="#64748b" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <Label fx:id="lblMemberInfo" text="N/A" textFill="#1e293b" GridPane.rowIndex="0" GridPane.columnIndex="1"><font><Font name="System Bold" size="13.0" /></font></Label>

            <Label text="Borrowed Date:" textFill="#64748b" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <Label fx:id="lblBorrowDate" text="N/A" textFill="#1e293b" GridPane.rowIndex="1" GridPane.columnIndex="1"><font><Font name="System Bold" size="13.0" /></font></Label>

            <Label text="Due Date:" textFill="#64748b" GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <Label fx:id="lblDueDate" text="N/A" textFill="#1e293b" GridPane.rowIndex="2" GridPane.columnIndex="1"><font><Font name="System Bold" size="13.0" /></font></Label>

            <Label text="Status:" textFill="#64748b" GridPane.rowIndex="3" GridPane.columnIndex="0" />
            <Label fx:id="lblStatus" text="Pending" textFill="#ef4444" GridPane.rowIndex="3" GridPane.columnIndex="1"><font><Font name="System Bold" size="13.0" /></font></Label>
        </GridPane>

        <VBox spacing="5">
            <Label text="Return Date" textFill="#4a4a4a"><font><Font name="System Bold" size="13.0" /></font></Label>
            <DatePicker fx:id="dpReturnDate" prefHeight="40.0" maxWidth="Infinity" style="-fx-background-radius: 6; -fx-border-color: #e0e0e0; -fx-border-radius: 6;" />
        </VBox>

        <Button text="Process Return" prefHeight="45.0" maxWidth="Infinity" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;">
            <font><Font name="System Bold" size="15.0" /></font>
        </Button>
    </VBox>
</VBox>