<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" style="-fx-padding: 30;" stylesheets="@../css/style.css" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.HistoryPageController">
    <Label styleClass="page-title" text="Borrowing History" />

    <VBox spacing="15.0" styleClass="card-panel" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <TextField fx:id="txtSearchHistory" prefHeight="38.0" prefWidth="250.0" promptText="Search Member, Book, or ID..." styleClass="input-field" />
            <ComboBox fx:id="cmbStatusFilter" prefHeight="38.0" prefWidth="150.0" />
            <Button mnemonicParsing="false" onAction="#btnFilterHistoryOnAction" prefHeight="38.0" prefWidth="100.0" styleClass="btn-primary" text="Filter" />
            <Button mnemonicParsing="false" onAction="#btnResetHistoryOnAction" prefHeight="38.0" prefWidth="100.0" styleClass="btn-neutral" text="Reset" />
        </HBox>

        <TableView fx:id="tblHistory" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colRecordId" prefWidth="75.0" text="ID" />
                <TableColumn fx:id="colMemberId" prefWidth="105.0" text="Member ID" />
                <TableColumn fx:id="colMemberName" prefWidth="150.0" text="Member Name" />
                <TableColumn fx:id="colBookId" prefWidth="105.0" text="Book ID" />
                <TableColumn fx:id="colBookTitle" prefWidth="170.0" text="Book Title" />
                <TableColumn fx:id="colIssueDate" prefWidth="110.0" text="Issue Date" />
                <TableColumn fx:id="colDueDate" prefWidth="110.0" text="Due Date" />
                <TableColumn fx:id="colReturnDate" prefWidth="110.0" text="Return Date" />
                <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
            </columns>
        </TableView>
    </VBox>
</VBox>