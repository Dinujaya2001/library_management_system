<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" style="-fx-padding: 30; -fx-background-color: transparent;" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.HistoryPageController">
    <Label text="Borrowing History" textFill="#333333">
        <font><Font name="System Bold" size="26.0" /></font>
    </Label>

    <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 5);" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <TextField fx:id="txtSearchHistory" prefHeight="36.0" prefWidth="250.0" promptText="Search Member, Book, or ID..." style="-fx-background-radius: 6; -fx-border-color: #e0e0e0; -fx-border-radius: 6;" />
            <ComboBox fx:id="cmbStatusFilter" prefHeight="36.0" prefWidth="150.0" style="-fx-background-radius: 6; -fx-border-color: #e0e0e0; -fx-border-radius: 6;" />
            <Button mnemonicParsing="false" onAction="#btnFilterHistoryOnAction" prefHeight="36.0" prefWidth="100.0" style="-fx-background-color: #1abfc7; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" text="Filter">
                <font><Font name="System Bold" size="13.0" /></font>
            </Button>
            <Button mnemonicParsing="false" onAction="#btnResetHistoryOnAction" prefHeight="36.0" prefWidth="100.0" style="-fx-background-color: transparent; -fx-border-color: #94a3b8; -fx-border-radius: 6; -fx-text-fill: #475569; -fx-cursor: hand;" text="Reset">
                <font><Font name="System Bold" size="13.0" /></font>
            </Button>
        </HBox>

        <TableView fx:id="tblHistory" style="-fx-border-color: #e0e0e0; -fx-border-radius: 6; -fx-background-radius: 6;" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colRecordId" prefWidth="75.0" text="ID" />
                <TableColumn fx:id="colMemberId" prefWidth="105.0" text="Member ID" />
                <TableColumn fx:id="colMemberName" prefWidth="150.0" text="Member Name" />
                <TableColumn fx:id="colBookId" prefWidth="105.0" text="Book ID" />
                <TableColumn fx:id="colBookTitle" prefWidth="170.0" text="Book Title" />
                <TableColumn fx:id="colIssueDate" prefWidth="110.0" text="Issue Date" />
                <TableColumn fx:id="colDueDate" prefWidth="110.0" text="Due Date" />
                <TableColumn fx:id="colReturnDate" prefWidth="110.0" text="Return Date" />
                <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
            </columns>
        </TableView>
    </VBox>
</VBox>